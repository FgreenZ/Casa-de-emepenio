<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry excluding="libraries/" kind="src" path="src"/>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-21">
		<attributes>
			<attribute name="module" value="true"/>
		</attributes>
	</classpathentry>
	<!-- Cambiar rutas absolutas a relativas -->
	<classpathentry kind="lib" path="libraries/openpdf-1.3.30.jar"/>
	<classpathentry kind="lib" path="libraries/mysql-connector-j-9.3.0.jar"/>
	<classpathentry kind="output" path="bin"/>
</classpath>